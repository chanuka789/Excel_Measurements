                    <bt:Image size="32" resid="I.measure.32"/>
                    <bt:Image size="80" resid="I.measure.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>openSmartTakeoff</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="DWFx.Schedules">
                  <Label resid="L.Schedules"/>
