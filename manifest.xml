        <bt:String id="G.Project" DefaultValue="Project"/>
        <bt:String id="G.Model" DefaultValue="Model"/>
        <bt:String id="G.View" DefaultValue="3D view"/>
        <bt:String id="G.Measure" DefaultValue="Measure"/>
        <bt:String id="G.AI" DefaultValue="AI"/>
        <bt:String id="G.Admin" DefaultValue="Admin"/>
