      <bt:LongStrings>
        <bt:String id="T.Projects" DefaultValue="Open your projects: models, drawings, team, saved take-offs and settings."/>
        <bt:String id="T.Refresh" DefaultValue="Reload the open project to see new uploads and processing status."/>
        <bt:String id="T.Elements" DefaultValue="Browse the model elements by category, family and type."/>
        <bt:String id="T.Zones" DefaultValue="Named zones (Villa, Annex, Block A) to split take-offs and colour the model."/>
        <bt:String id="T.Window" DefaultValue="Open the model in a large window that can go on a second screen, with drawings side by side."/>
        <bt:String id="T.Fit" DefaultValue="Zoom the 3D view to the visible elements."/>
        <bt:String id="T.Views" DefaultValue="Top, front, side and isometric views; perspective or orthographic."/>
        <bt:String id="T.Section" DefaultValue="Cut the model with a section box to see inside."/>
        <bt:String id="T.Plan" DefaultValue="Top view of one level, cut at a set height, like a plan drawing."/>
        <bt:String id="T.Saved" DefaultValue="Save or open views with camera, section, selection and colours, shared with the team."/>
        <bt:String id="T.Isolate" DefaultValue="Show only the selected elements. Press again to show the rest."/>
        <bt:String id="T.Hide" DefaultValue="Hide the selected elements."/>
        <bt:String id="T.ShowAll" DefaultValue="Show every element and clear isolate, hide and the level filter."/>
        <bt:String id="T.Box" DefaultValue="Drag a box: left to right selects elements fully inside, right to left anything touched."/>
        <bt:String id="T.Clear" DefaultValue="Clear the element selection."/>
        <bt:String id="T.FromExcel" DefaultValue="Highlight in 3D the elements of the Take-off rows selected in Excel."/>
        <bt:String id="T.Measure" DefaultValue="Measure the selected elements and add live formulas to the Take-off sheet."/>
        <bt:String id="T.Templates" DefaultValue="Saved methods and discipline packs for Structure, Architecture, Interiors and MEP."/>
        <bt:String id="T.Tool" DefaultValue="Measure a distance between two points or the area of a face in 3D."/>
        <bt:String id="T.Colour" DefaultValue="Colour the model by category, level, material, zone, property or revision changes."/>
        <bt:String id="T.Status" DefaultValue="Green measured, purple measured twice, red not measured yet."/>
        <bt:String id="T.AskAI" DefaultValue="Ask the AI to work out a measurement method; it tests it on the model before you add it."/>
        <bt:String id="T.Check" DefaultValue="AI review of the take-off for missing items, odd values, unit mistakes and double counting."/>
        <bt:String id="T.Compare" DefaultValue="Added, removed and changed elements between two model versions, with quantity differences."/>
        <bt:String id="T.Update" DefaultValue="Re-measure take-off groups on the new revision, keeping formulas and assumptions."/>
        <bt:String id="T.BOQ" DefaultValue="Build a BOQ sheet linked to the take-off totals, with AI descriptions if you want."/>
        <bt:String id="T.PDF" DefaultValue="A PDF with the method, assumptions, counts, totals and a 3D picture of every group."/>
        <bt:String id="T.Review" DefaultValue="Missing data, overlapping concrete and measured status."/>
        <bt:String id="T.Admin" DefaultValue="Users, AI settings, QS rules, backups and system status (administrators only)."/>
        <bt:String id="GetStarted.Description" DefaultValue="Open the DWFx Measure tab on the ribbon and choose Projects to sign in."/>
      </bt:LongStrings>
