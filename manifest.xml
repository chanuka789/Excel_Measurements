        <bt:String id="L.Refresh" DefaultValue="Refresh"/>
        <bt:String id="L.Elements" DefaultValue="Elements"/>
        <bt:String id="L.Fit" DefaultValue="Fit view"/>
        <bt:String id="L.ShowAll" DefaultValue="Show all"/>
        <bt:String id="L.Isolate" DefaultValue="Isolate"/>
        <bt:String id="L.Clear" DefaultValue="Clear selection"/>
        <bt:String id="L.Measure" DefaultValue="Measure"/>
        <bt:String id="L.FromExcel" DefaultValue="Select from Excel"/>
        <bt:String id="L.AskAI" DefaultValue="Ask AI"/>
        <bt:String id="L.Admin" DefaultValue="Admin"/>
        <bt:String id="TabLabel" DefaultValue="DWFx Measure"/>
