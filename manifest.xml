                    <bt:Image size="32" resid="I.boq.32"/>
                    <bt:Image size="80" resid="I.boq.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>openSmartOutput</FunctionName></Action>
                </Control>
                <Control xsi:type="Button" id="DWFx.Audit">
                  <Label resid="L.Audit"/>
                  <Supertip><Title resid="L.Audit"/><Description resid="T.Audit"/></Supertip>
                  <Icon>
                    <bt:Image size="16" resid="I.aicheck.16"/>
                    <bt:Image size="32" resid="I.aicheck.32"/>
                    <bt:Image size="80" resid="I.aicheck.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction"><FunctionName>aiCheck</FunctionName></Action>
                </Control>
              </Group>
              <Label resid="TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
