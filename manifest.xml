      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="T.Projects" DefaultValue="Open your projects: models, drawings, team and saved take-offs."/>
        <bt:String id="T.Refresh" DefaultValue="Reload the open project to see new uploads and processing status."/>
        <bt:String id="T.Elements" DefaultValue="Browse the model elements by category, family and type."/>
        <bt:String id="T.Fit" DefaultValue="Zoom the 3D view to the visible elements."/>
        <bt:String id="T.ShowAll" DefaultValue="Show every element and clear the level filter."/>
        <bt:String id="T.Isolate" DefaultValue="Show only the selected elements in 3D. Press again to show the rest."/>
        <bt:String id="T.Clear" DefaultValue="Clear the element selection."/>
        <bt:String id="T.Measure" DefaultValue="Measure the selected elements and add live formulas to the Take-off sheet."/>
        <bt:String id="T.FromExcel" DefaultValue="Highlight in 3D the elements of the Take-off rows you selected in Excel."/>
        <bt:String id="T.AskAI" DefaultValue="Ask the AI to work out a measurement method, for example beam formwork."/>
        <bt:String id="T.Admin" DefaultValue="Users, password hashes, backups and system status (administrators only)."/>
