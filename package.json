{
  "name": "dwfx-structural-addin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Excel add-in: DWFx 3D viewer linked to structural measurement sheet and BOQ",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "icons": "python3 scripts/make-icons.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "archiver": "7.0.1",
    "compression": "1.7.5",
    "dwf-viewer": "0.6.7",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "pg": "8.13.1",
    "three": "0.160.0"
  }
}