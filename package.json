{
  "name": "dwfx-structural-addin",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Excel add-in: DWFx 3D viewer linked to structural measurement sheet and BOQ",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "icons": "python3 scripts/make-icons.py",
    "manifest": "python3 scripts/make-manifest.py",
    "standards": "node scripts/build-standards.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@mlightcad/libredwg-web": "0.8.2",
    "archiver": "7.0.1",
    "compression": "1.8.2",
    "dwf-viewer": "0.6.7",
    "dxf-parser": "1.1.2",
    "esbuild": "0.25.10",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "polygon-clipping": "0.15.7",
    "three": "0.160.0",
    "three-mesh-bvh": "0.7.8"
  }
}
